+// ---------------------------------------------------------------------------
+// iPhone message style (style only, added 2026-11-01).
+// These helpers are used only when Settings::iphoneMessageStyle is on.
+// They never touch channels, protocols, moderation, or emote providers.
+// The platform outline reuses Mergerino's own platform accent, which is
+// already purple for Twitch (145, 70, 255) and green for Kick (83, 252, 24),
+// so the 12-answer colours come from upstream data, not a new mapping.
+// ---------------------------------------------------------------------------
+
+bool iphoneStyleEnabled()
+{
+    return getSettings()->iphoneMessageStyle.getValue();
+}
+
+/// True when this message was sent by the currently logged-in account, on
+/// either platform. Twitch and Kick accounts are checked independently, so
+/// a user logged in as official_robust_clan on both is "own" on both.
+/// Anonymous accounts never match: an empty login name is not own.
+bool iphoneIsOwnMessage(const Message &message)
+{
+    if (message.loginName.isEmpty())
+    {
+        return false;
+    }
+    auto *accounts = getApp()->getAccounts();
+    if (accounts == nullptr)
+    {
+        return false;
+    }
+    if (auto twitch = accounts->twitch.getCurrent(); twitch != nullptr &&
+        !twitch->isAnon() &&
+        twitch->getUserName().compare(message.loginName,
+                                      Qt::CaseInsensitive) == 0)
+    {
+        return true;
+    }
+    if (auto kick = accounts->kick.current(); kick != nullptr &&
+        !kick->isAnonymous() &&
+        kick->username().compare(message.loginName,
+                                 Qt::CaseInsensitive) == 0)
+    {
+        return true;
+    }
+    return false;
+}
+
+QString iphoneDisplayName(const Message &message)
+{
+    return message.displayName.isEmpty() ? message.loginName
+                                         : message.displayName;
+}
+
+/// The single initial painted in the avatar circle for received messages.
+/// Initials only: Qt chat rows carry no per-message profile photo (see the
+/// README), and no face or photo is guessed here.
+QChar iphoneAvatarInitial(const Message &message)
+{
+    const QString name = iphoneDisplayName(message);
+    return name.isEmpty() ? QChar('?') : name.at(0).toUpper();
+}
+
+QColor iphoneOutlineColor(const Message &message)
+{
+    return message.platformAccentColor.value_or(
+        defaultPlatformAccent(message.platform));
+}
+
+/// Bubble fill for iPhone style. Sent messages use iOS message blue in
+/// both themes; received messages use the iOS system grey for the current
+/// theme, inferred from the chat text colour (dark text = light theme).
+/// Highlighted messages keep their highlight colour as the fill instead;
+/// see MessageLayout::paintBackground.
+QColor iphoneBubbleFill(const QColor &textColor, bool isOwn)
+{
+    if (isOwn)
+    {
+        return QColor("#0a84ff");
+    }
+    const bool lightTheme = textColor.lightness() < 128;
+    return lightTheme ? QColor("#e9e9eb") : QColor("#2c2c2e");
+}
